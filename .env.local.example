# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. NEVER expose to the browser. Used only by trusted server scripts.
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the single admin user. Set this after creating the admin user in Supabase Auth.
# Find it under Authentication > Users in the Supabase dashboard.
ADMIN_USER_ID=
